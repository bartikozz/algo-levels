# ── Algo Levels data server (.env stays only on the VPS, never in git) ──
# token the web terminal sends as ?t=  (use the same one as the Cloudflare Worker, or a new one)
ACCESS_TOKEN=change-me
# Databento API key (portal → API keys). Live CME data, non-professional license.
DATABENTO_API_KEY=
FUT_SYMBOL=NQ.v.0
# ThetaData: Theta Terminal runs locally on this machine (see deploy/setup.sh)
THETA_API=v3
THETA_BASE=http://127.0.0.1:25503
OPTIONS_ROOT=QQQ
POLL_SEC=30
CORS_ORIGINS=https://bartikozz.github.io
# DEMO=1 → synthetic data, for testing without subscriptions
DEMO=0
# ── options flow (ThetaData live stream of QQQ option trades) ──
# THETA_STREAM=0 turns it off. Options Standard = per-contract streams (contracts mode), Pro = bulk.
THETA_STREAM=1
THETA_STREAM_MODE=contracts
THETA_WS=ws://127.0.0.1:25520/v1/events
STREAM_DAYS=7
STREAM_PCT=0.06
STREAM_MAX=3000
THETA_STREAM_QUOTES=1
# tape shows orders with at least this premium in $
FLOW_MIN_PREM=25000
