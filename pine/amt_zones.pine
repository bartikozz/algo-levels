//@version=6
// AMT Zones — auction market theory zones in the style of gradient "acceptance" bands.
//  • HVN zones: prices where the auction accepted value (high volume) inside the lookback window, that price has
//    since LEFT. On a return they act as reference — either responsive rejection at the edge or acceptance back inside.
//    Drawn as a gradient: the darker the core, the more volume traded there (the node's own volume distribution).
//  • LVN edges (optional): thin rejection gaps between nodes — fast travel / clean reaction areas.
//  • Poor highs / lows: flat extremes (≥2 bars within 1 tick, no tail) = unfinished auctions, kept until repaired.
//  • Naked POC of the previous session (optional).
// Volume per price row = each bar's volume spread evenly over its high–low range (bar-based volume profile).
indicator("AMT Zones", "AMT Zones", overlay = true, max_boxes_count = 500, max_lines_count = 200, max_labels_count = 50, max_bars_back = 2000)

// ───────── inputs
gP        = "Profil"
lookback  = input.int(390, "Lookback (bary)", minval = 60, maxval = 1900, group = gP, tooltip = "1m graf: 390 ≈ jedna RTH session, 1380 ≈ celý Globex den")
rows      = input.int(160, "Řádky profilu", minval = 40, maxval = 400, group = gP)
hvnMult   = input.float(1.45, "HVN práh (× průměr profilu)", minval = 1.0, step = 0.05, group = gP)
edgeFrac  = input.float(0.55, "Hrana zóny (podíl vrcholu)", minval = 0.2, maxval = 0.9, step = 0.05, group = gP)
leftGap   = input.float(1.0, "Cena musí zónu opustit o (× ATR)", minval = 0.0, step = 0.25, group = gP, tooltip = "Zóna se ukáže, až cena odejde z oblasti přijetí – pak je to reference pro návrat.")
maxZones  = input.int(6, "Max zón", minval = 1, maxval = 12, group = gP)
showLvn   = input.bool(false, "LVN mezery mezi zónami", group = gP)

gS        = "Struktura"
showPoor  = input.bool(true, "Poor highs / lows", group = gS)
pivLen    = input.int(4, "Délka pivotu", minval = 2, maxval = 20, group = gS)
showNpoc  = input.bool(true, "Naked POC předchozí session", group = gS)
sessRth   = input.session("0930-1600", "RTH (čas New York)", group = gS)

gV        = "Vzhled"
ext       = input.int(18, "Prodloužení doprava (bary)", minval = 0, maxval = 300, group = gV)
layers    = input.int(6, "Vrstvy gradientu", minval = 2, maxval = 12, group = gV)
zCol      = input.color(color.rgb(40, 42, 48), "Barva zóny", group = gV)
baseAlpha = input.int(86, "Průhlednost vrstvy", minval = 50, maxval = 97, group = gV)
poorCol   = input.color(color.rgb(201, 166, 107), "Poor high/low", group = gV)
npocCol   = input.color(color.rgb(239, 83, 80), "Naked POC", group = gV)
showCount = input.bool(true, "Počet zón vlevo nahoře", group = gV)

atr = ta.atr(50)

// ───────── HVN zones (recomputed once per new bar on the last bar)
var array<box>  zBoxes = array.new<box>()
var array<line> zLines = array.new<line>()
var label       cntLbl = na
varip int       lastCalcBar = -1

if barstate.islast and bar_index != lastCalcBar
    lastCalcBar := bar_index
    for b in zBoxes
        box.delete(b)
    array.clear(zBoxes)
    for l in zLines
        line.delete(l)
    array.clear(zLines)

    n = math.min(lookback, bar_index + 1)
    float hi = high
    float lo = low
    for i = 0 to n - 1
        hi := math.max(hi, high[i])
        lo := math.min(lo, low[i])
    step = (hi - lo) / rows
    int zoneCount = 0
    if step > 0
        vol   = array.new_float(rows, 0.0)
        first = array.new_int(rows, -1)            // oldest bar offset that traded in the row (zone start)
        for i = 0 to n - 1
            r0 = math.max(0, int(math.floor((low[i] - lo) / step)))
            r1 = math.min(rows - 1, int(math.floor((high[i] - lo) / step)))
            share = nz(volume[i]) / (r1 - r0 + 1)
            for r = r0 to r1
                array.set(vol, r, array.get(vol, r) + share)
                array.set(first, r, i)
        // smoothed profile (triangular 5-row kernel)
        sm = array.new_float(rows, 0.0)
        for r = 0 to rows - 1
            float a = 0.0
            float c = 0.0
            for d = -2 to 2
                rr = r + d
                if rr >= 0 and rr < rows
                    w = 3 - math.abs(d)
                    a += array.get(vol, rr) * w
                    c += w
            array.set(sm, r, a / c)
        mean = array.avg(sm)
        // local maxima above the HVN threshold
        peakRows = array.new_int()
        peakVols = array.new_float()
        for r = 1 to rows - 2
            v = array.get(sm, r)
            if v >= hvnMult * mean
                bool isMax = true
                for d = -4 to 4
                    rr = r + d
                    if d != 0 and rr >= 0 and rr < rows and array.get(sm, rr) > v
                        isMax := false
                if isMax
                    array.push(peakRows, r)
                    array.push(peakVols, v)
        // strongest first
        ord = array.sort_indices(peakVols, order.descending)
        usedLo = array.new_float()
        usedHi = array.new_float()
        for k = 0 to math.max(0, array.size(ord) - 1)
            if zoneCount >= maxZones or array.size(ord) == 0
                break
            r  = array.get(peakRows, array.get(ord, k))
            pk = array.get(sm, r)
            int a = r
            int b = r
            while a > 0 and array.get(sm, a - 1) >= edgeFrac * pk
                a -= 1
            while b < rows - 1 and array.get(sm, b + 1) >= edgeFrac * pk
                b += 1
            zLo  = lo + a * step
            zHi  = lo + (b + 1) * step
            mid  = lo + (r + 0.5) * step
            // only zones price has left (acceptance behind us = reference for the return)
            bool left = close > zHi + leftGap * atr or close < zLo - leftGap * atr
            bool overlap = false
            if array.size(usedLo) > 0
                for j = 0 to array.size(usedLo) - 1
                    if zHi >= array.get(usedLo, j) and zLo <= array.get(usedHi, j)
                        overlap := true
            if left and not overlap
                array.push(usedLo, zLo)
                array.push(usedHi, zHi)
                zoneCount += 1
                x1 = bar_index - math.max(0, array.get(first, r))
                x2 = bar_index + ext
                // gradient: nested bands shrinking to the peak, each row's volume shapes the inner core
                for g = 0 to layers - 1
                    f  = 1.0 - g / layers
                    bt = mid + (zHi - mid) * f
                    bb = mid - (mid - zLo) * f
                    array.push(zBoxes, box.new(x1, bt, x2, bb, border_color = na, bgcolor = color.new(zCol, baseAlpha), xloc = xloc.bar_index))
                // core line at the node's peak
                array.push(zLines, line.new(x1, mid, x2, mid, xloc = xloc.bar_index, color = color.new(zCol, 30), width = 2))
        // LVN gaps between accepted zones
        if showLvn and array.size(usedLo) > 1
            sortedLo = array.copy(usedLo)
            array.sort(sortedLo)
            for j = 0 to array.size(sortedLo) - 2
                // lowest-volume row between consecutive zones
                int ra = int(math.floor((array.get(sortedLo, j) - lo) / step))
                int rb = int(math.floor((array.get(sortedLo, j + 1) - lo) / step))
                float best = 1e100
                int br = -1
                for r = ra to rb
                    if r >= 0 and r < rows and array.get(sm, r) < best
                        best := array.get(sm, r)
                        br := r
                if br >= 0
                    p = lo + (br + 0.5) * step
                    array.push(zLines, line.new(bar_index - n + 1, p, bar_index + ext, p, color = color.new(color.purple, 40), style = line.style_dotted))
    if showCount
        label.delete(cntLbl)
        cntLbl := label.new(bar_index - math.min(lookback, bar_index) + 1, hi, str.tostring(zoneCount), style = label.style_label_down, color = color.new(color.gray, 70), textcolor = color.white, size = size.small)

// ───────── poor highs / lows (unfinished auctions) — kept until repaired
var array<line> poorL = array.new<line>()
var array<float> poorP = array.new<float>()
var array<int>   poorS = array.new<int>()      // +1 poor high, -1 poor low
ph = ta.pivothigh(high, pivLen, pivLen)
pl = ta.pivotlow(low, pivLen, pivLen)
tick = syminfo.mintick
if showPoor and not na(ph)
    int cnt = 0
    for i = 0 to 2 * pivLen
        if math.abs(high[i] - ph) <= tick
            cnt += 1
    if cnt >= 2
        array.push(poorL, line.new(bar_index - pivLen, ph, bar_index + ext, ph, color = poorCol, style = line.style_dashed, width = 1))
        array.push(poorP, ph)
        array.push(poorS, 1)
if showPoor and not na(pl)
    int cnt = 0
    for i = 0 to 2 * pivLen
        if math.abs(low[i] - pl) <= tick
            cnt += 1
    if cnt >= 2
        array.push(poorL, line.new(bar_index - pivLen, pl, bar_index + ext, pl, color = poorCol, style = line.style_dashed, width = 1))
        array.push(poorP, pl)
        array.push(poorS, -1)
// repair: price trades through → stop extending; otherwise keep it pinned ahead of price
if array.size(poorL) > 0
    for j = array.size(poorL) - 1 to 0
        p = array.get(poorP, j)
        s = array.get(poorS, j)
        ln = array.get(poorL, j)
        if (s == 1 and high > p + tick) or (s == -1 and low < p - tick)
            line.set_x2(ln, bar_index)
            line.set_color(ln, color.new(poorCol, 75))
            array.remove(poorL, j)
            array.remove(poorP, j)
            array.remove(poorS, j)
        else
            line.set_x2(ln, bar_index + ext)

// ───────── naked POC of the previous RTH session (bar-based profile, 1-tick precision is approximated by rows)
inRth   = not na(time(timeframe.period, sessRth, "America/New_York"))
rthStart = inRth and not inRth[1]
rthEnd   = not inRth and inRth[1]
var float sHi = na
var float sLo = na
var int   sBar = na
var line  npoc = na
var float npocP = na
if rthStart
    sHi := high
    sLo := low
    sBar := bar_index
else if inRth
    sHi := math.max(nz(sHi, high), high)
    sLo := math.min(nz(sLo, low), low)
if showNpoc and rthEnd and not na(sBar)
    len = bar_index - sBar
    rN  = 80
    stp = (sHi - sLo) / rN
    if stp > 0 and len > 5
        pv = array.new_float(rN, 0.0)
        for i = 1 to len
            r0 = math.max(0, int(math.floor((low[i] - sLo) / stp)))
            r1 = math.min(rN - 1, int(math.floor((high[i] - sLo) / stp)))
            for r = r0 to r1
                array.set(pv, r, array.get(pv, r) + nz(volume[i]) / (r1 - r0 + 1))
        pr = array.indexof(pv, array.max(pv))
        line.delete(npoc)
        npocP := sLo + (pr + 0.5) * stp
        npoc := line.new(bar_index - 1, npocP, bar_index + ext, npocP, color = npocCol, width = 1, style = line.style_solid)
if not na(npocP) and not na(npoc)
    if high >= npocP and low <= npocP and not rthEnd
        line.set_x2(npoc, bar_index)
        line.set_color(npoc, color.new(npocCol, 80))
        npoc := na
        npocP := na
    else
        line.set_x2(npoc, bar_index + ext)

