//@version=6
// AMT LVN Zones FP — LVN zones drawn as bands across the chart (MotiveWave style) from a multi-day composite
// footprint volume profile (real volume at price, TradingView Premium / Ultimate).
//  • LVN zone = contiguous price rows whose volume is ≤ X × the smaller of the two surrounding volume peaks
//               (a real valley between two nodes, not a tail). Width = the whole thin area.
//  • Confirmation: a zone that also sits on an LVN of the previous RTH (PD), the overnight (ETH) or today's RTH
//               profile is drawn brighter and labelled with those profiles.
//  • Refined: zones are found on the smoothed profile, then edges and the core (thinnest 3 rows) are refined on
//    the raw 1-point footprint rows; depth = how empty the valley is vs. the surrounding nodes.
//  • Works in Bar Replay (everything is drawn on the last / replayed bar). Bars without footprint data fall back
//    to an OHLC estimate — the status box top-right shows which one is used.
//  • Single prints from 1-minute data (on any chart timeframe): price rows (1 tick) traded by only ONE 1-minute
//    bar of the RTH (optionally ETH) session. They disappear as soon as price touches them.
//  • Optional: shelves (abrupt volume step) and HVN bands.
indicator("AMT LVN Zones FP", "LVN Zones", overlay = true, max_boxes_count = 500, max_lines_count = 100, max_labels_count = 200)

// ───────── inputs
gP        = "Composite profil"
days      = input.int(10, "Dní v profilu", minval = 1, maxval = 30, group = gP, tooltip = "Globex dny (18:00–17:00 NY). Graf musí mít načtenou historii za tolik dní.")
tpr       = input.int(4, "Ticků na řádek", minval = 1, maxval = 80, group = gP, tooltip = "NQ/MNQ: 4 = 1 bod, 8 = 2 body, 20 = 5 bodů")
smoothPts = input.float(6.0, "Vyhlazení (body)", minval = 0.0, maxval = 50.0, step = 1.0, group = gP)
showProf  = input.bool(true, "Ukázat profil vpravo", group = gP)
profW     = input.int(60, "Šířka profilu (bary)", minval = 10, maxval = 300, group = gP)

gL        = "LVN zóny"
lvnFrac   = input.float(0.5, "LVN: objem ≤ × nižšího okolního vrcholu", minval = 0.1, maxval = 0.9, step = 0.05, group = gL)
winPts    = input.float(80.0, "Okno pro okolní vrcholy (body)", minval = 10.0, maxval = 600.0, step = 5.0, group = gL)
minWPts   = input.float(4.0, "Min. šířka zóny (body)", minval = 0.0, maxval = 100.0, step = 1.0, group = gL)
mergePts  = input.float(4.0, "Spojit zóny bližší než (body)", minval = 0.0, maxval = 50.0, step = 1.0, group = gL)
maxZ      = input.int(30, "Max. zón (nejbližší k ceně)", minval = 1, maxval = 80, group = gL)

gC        = "Konfluence (PD / ETH / RTH)"
useConf   = input.bool(true, "Kontrolovat session profily", group = gC)
mode      = input.string("Potvrzené + silné", "Které zóny ukázat", options = ["Potvrzené + silné", "Jen potvrzené", "Všechny"], group = gC, tooltip = "Silná = hloubka údolí ≥ práh níže (objem v jádru zóny proti okolním uzlům).")
strongD   = input.float(0.75, "Silná zóna: hloubka ≥", minval = 0.3, maxval = 0.98, step = 0.01, group = gC)
sessWin   = input.float(30.0, "Okno session profilů (body)", minval = 5.0, maxval = 300.0, step = 5.0, group = gC)
confTol   = input.float(3.0, "Tolerance (body)", minval = 0.0, step = 0.5, group = gC)
sessRth   = input.session("0930-1600", "RTH (čas NY)", group = gC)
sessEth   = input.session("1800-0930", "ETH / overnight (čas NY)", group = gC)

gO        = "Další uzly"
showS     = input.bool(true, "Shelfy", group = gO)
shelfPts  = input.float(10.0, "Shelf okno (body)", minval = 2.0, maxval = 100.0, step = 1.0, group = gO)
shelfRat  = input.float(2.5, "Shelf skok objemu (×)", minval = 1.5, maxval = 10.0, step = 0.1, group = gO)
showH     = input.bool(false, "HVN pásy", group = gO)
hvnMult   = input.float(1.5, "HVN práh (× průměr)", minval = 1.0, step = 0.05, group = gO)

gV        = "Vzhled"
backBars  = input.int(1500, "Pásy doleva (bary)", minval = 50, maxval = 5000, group = gV)
ext       = input.int(10, "Mezera vpravo (bary)", minval = 0, maxval = 200, group = gV)
lvnCol    = input.color(color.rgb(140, 140, 140), "LVN zóna", group = gV)
alphaBase = input.int(80, "Průhlednost nepotvrzené", minval = 0, maxval = 100, group = gV)
alphaConf = input.int(58, "Průhlednost potvrzené", minval = 0, maxval = 100, group = gV)
profCol   = input.color(color.rgb(230, 230, 230), "Profil", group = gV)
shCol     = input.color(color.rgb(255, 183, 77), "Shelf", group = gV)
hvnCol    = input.color(color.rgb(94, 224, 200), "HVN", group = gV)
showLbl   = input.bool(true, "Popisky zón", group = gV)
showCore  = input.bool(true, "Jádro LVN (nejtenčí cena) jako čára", group = gV)
coreCol   = input.color(color.rgb(200, 200, 200), "Jádro", group = gV)
showScale = input.bool(true, "Nejbližší zóny na cenové ose", group = gV)
showInfo  = input.bool(true, "Stav dat (footprint / odhad)", group = gV)

gSP       = "Single prints (TPO)"
spOnR     = input.bool(true, "Single prints z RTH", group = gSP)
spOnE     = input.bool(false, "Single prints z ETH (overnight)", group = gSP)
spDev     = input.bool(true, "Ukázat i dnešní (běžící session)", group = gSP)
spRowPts  = input.float(0.25, "Řádek (body)", minval = 0.25, maxval = 20.0, step = 0.25, group = gSP, tooltip = "0.25 = 1 tick (nejpřesnější)")
spMinPts  = input.float(2.0, "Min. délka (body)", minval = 0.25, maxval = 100.0, step = 0.25, group = gSP)
spTails   = input.bool(false, "Včetně tailů na extrémech (excess)", group = gSP)
spMax     = input.int(30, "Max. nevyplněných", minval = 1, maxval = 100, group = gSP)
spCol     = input.color(color.rgb(100, 181, 246), "Single prints", group = gSP)

// ───────── footprint of the bar → rows (key = row bottom in ticks, snapped to the row grid)
footprint fp = request.footprint(tpr, 70, 300)
float tk    = syminfo.mintick
float rowSz = tk * tpr
rowKey(float p) => int(math.floor(p / rowSz + 1e-6)) * tpr
toRows(float pts) => math.max(1, int(math.round(pts / rowSz)))

curK = array.new_int()
curV = array.new_float()
if not na(fp)
    rs = footprint.rows(fp)
    if array.size(rs) > 0
        for i = 0 to array.size(rs) - 1
            r = array.get(rs, i)
            array.push(curK, rowKey(volume_row.down_price(r)))
            array.push(curV, volume_row.total_volume(r))
else
    k0 = rowKey(low)
    k1 = rowKey(high)
    cnt = int(math.round((k1 - k0) / tpr)) + 1
    for j = 0 to cnt - 1
        array.push(curK, k0 + j * tpr)
        array.push(curV, nz(volume) / cnt)

// ───────── composite over the last N Globex days (finished days kept in flat arrays, current day live)
newDay = timeframe.change("D")
var map<int, float> mDay  = map.new<int, float>()
var map<int, float> mComp = map.new<int, float>()
var array<int>   sDay = array.new_int()
var array<int>   sKey = array.new_int()
var array<float> sVol = array.new_float()
var int dayN = 0
if newDay and map.size(mDay) > 0
    for k in map.keys(mDay)
        array.push(sDay, dayN)
        array.push(sKey, k)
        array.push(sVol, map.get(mDay, k))
    map.clear(mDay)
    dayN += 1
    while array.size(sDay) > 0 and array.get(sDay, 0) <= dayN - days
        array.shift(sDay)
        k = array.shift(sKey)
        v = array.shift(sVol)
        nv = nz(map.get(mComp, k)) - v
        if nv <= 1e-9
            map.remove(mComp, k)
        else
            map.put(mComp, k, nv)

// ───────── session profiles (PD = previous RTH, ETH = overnight, RTH = today)
inRth    = not na(time(timeframe.period, sessRth, "America/New_York"))
inEth    = not na(time(timeframe.period, sessEth, "America/New_York"))
rthEnd   = not inRth and inRth[1]
ethStart = inEth and not inEth[1]
var map<int, float> mRth = map.new<int, float>()
var map<int, float> mEth = map.new<int, float>()
var map<int, float> mPd  = map.new<int, float>()
if rthEnd
    mPd := map.copy(mRth)
    map.clear(mRth)
if ethStart
    map.clear(mEth)

if barstate.isconfirmed and array.size(curK) > 0
    for i = 0 to array.size(curK) - 1
        k = array.get(curK, i)
        v = array.get(curV, i)
        map.put(mDay, k, nz(map.get(mDay, k)) + v)
        map.put(mComp, k, nz(map.get(mComp, k)) + v)
        if inRth
            map.put(mRth, k, nz(map.get(mRth, k)) + v)
        if inEth
            map.put(mEth, k, nz(map.get(mEth, k)) + v)

// ───────── single prints (TPO): count of distinct periods per price row, per session
float spSz = math.max(tk, math.round(spRowPts / tk) * tk)
spK(float p) => int(math.floor(p / spSz + 1e-6))
rthStart = inRth and not inRth[1]
ethEnd   = not inEth and inEth[1]
var int t0R = na
var int t0E = na
var int b0R = na
var int b0E = na
var map<int, int> cR = map.new<int, int>()
var map<int, int> pR = map.new<int, int>()
var map<int, int> cE = map.new<int, int>()
var map<int, int> pE = map.new<int, int>()
if rthStart
    map.clear(cR)
    map.clear(pR)
    t0R := time
    b0R := bar_index
if ethStart
    map.clear(cE)
    map.clear(pE)
    t0E := time
    b0E := bar_index

// 1-minute bars inside the chart bar (on a 1m chart: the bar itself)
[lh1, ll1, lt1] = request.security_lower_tf(syminfo.tickerid, "1", [high, low, time])

spTouch(map<int, int> cnt, map<int, int> per, float h, float l, int prd) =>
    int k0 = spK(l)
    int k1 = spK(h)
    if k1 - k0 < 2000 and k1 >= k0
        for k = k0 to k1
            if nz(map.get(per, k), -1) != prd
                map.put(per, k, prd)
                map.put(cnt, k, nz(map.get(cnt, k)) + 1)
    0

// runs of rows traded by exactly one 1-minute bar → [low, high]
spRuns(map<int, int> cnt) =>
    lo = array.new_float()
    hi = array.new_float()
    if map.size(cnt) > 2
        keys = map.keys(cnt)
        int kMin = int(array.min(keys))
        int kMax = int(array.max(keys))
        int minLen = math.max(1, int(math.round(spMinPts / spSz)))
        int a = -1
        int b = -1
        if kMax - kMin < 8000
            for k = kMin to kMax + 1
                bool single = k <= kMax and nz(map.get(cnt, k)) == 1
                if single
                    if a < 0
                        a := k
                    b := k
                else if a >= 0
                    bool atEdge = a == kMin or b == kMax
                    if b - a + 1 >= minLen and (spTails or not atEdge)
                        array.push(lo, a * spSz)
                        array.push(hi, (b + 1) * spSz - tk)
                    a := -1
    [lo, hi]

spAdd(array<float> L, array<float> H, array<int> B, array<int> T, array<int> S, array<int> M, array<float> lo, array<float> hi, int b0, int t0, int src) =>
    if array.size(lo) > 0
        for i = 0 to array.size(lo) - 1
            array.push(L, array.get(lo, i))
            array.push(H, array.get(hi, i))
            array.push(B, b0)
            array.push(T, t0)
            array.push(S, src)
            array.push(M, bar_index)
    while array.size(L) > spMax
        array.shift(L)
        array.shift(H)
        array.shift(B)
        array.shift(T)
        array.shift(S)
        array.shift(M)
    0

var array<float> spL = array.new_float()
var array<float> spH = array.new_float()
var array<int>   spB = array.new_int()
var array<int>   spT = array.new_int()
var array<int>   spS = array.new_int()
var array<int>   spM = array.new_int()

if barstate.isconfirmed and array.size(lh1) > 0
    for j = 0 to array.size(lh1) - 1
        float h1 = array.get(lh1, j)
        float l1 = array.get(ll1, j)
        int   m1 = int(array.get(lt1, j) / 60000)
        if not na(h1) and not na(l1)
            // touch = finished single print disappears
            if array.size(spL) > 0
                for i = array.size(spL) - 1 to 0
                    if array.get(spM, i) < bar_index and h1 >= array.get(spL, i) and l1 <= array.get(spH, i)
                        array.remove(spL, i)
                        array.remove(spH, i)
                        array.remove(spB, i)
                        array.remove(spT, i)
                        array.remove(spS, i)
                        array.remove(spM, i)
            if inRth and spOnR and not na(t0R)
                spTouch(cR, pR, h1, l1, m1)
            if inEth and spOnE and not na(t0E)
                spTouch(cE, pE, h1, l1, m1)
if rthEnd and spOnR and not na(b0R)
    [fl, fh] = spRuns(cR)
    spAdd(spL, spH, spB, spT, spS, spM, fl, fh, b0R, t0R, 0)
if ethEnd and spOnE and not na(b0E)
    [gl, gh] = spRuns(cE)
    spAdd(spL, spH, spB, spT, spS, spM, gl, gh, b0E, t0E, 1)

// ───────── profile helpers
build(map<int, float> m, int sN) =>
    int kMin = 0
    int n = 0
    vol = array.new_float()
    sm  = array.new_float()
    if map.size(m) > 4
        keys = map.keys(m)
        kMin := int(array.min(keys))
        int kMax = int(array.max(keys))
        n := math.min(4000, int(math.round((kMax - kMin) / tpr)) + 1)
        vol := array.new_float(n, 0.0)
        for k in keys
            int idx = int(math.round((k - kMin) / tpr))
            if idx >= 0 and idx < n
                array.set(vol, idx, array.get(vol, idx) + map.get(m, k))
        sm := array.new_float(n, 0.0)
        for r = 0 to n - 1
            float acc = 0.0
            float wsum = 0.0
            for d = -sN to sN
                int rr = r + d
                if rr >= 0 and rr < n
                    float w = sN + 1 - math.abs(d)
                    acc += array.get(vol, rr) * w
                    wsum += w
            array.set(sm, r, acc / wsum)
    [kMin, n, vol, sm]

// L[r] = max a[r-W .. r-1], R[r] = max a[r+1 .. r+W]  (O(n), van Herk / Gil-Werman blocks)
winMax(array<float> a, int n, int W) =>
    L = array.new_float(math.max(n, 1), 0.0)
    R = array.new_float(math.max(n, 1), 0.0)
    if n > 1
        g  = array.new_float(n, 0.0)
        h  = array.new_float(n, 0.0)
        pm = array.new_float(n, 0.0)
        qm = array.new_float(n, 0.0)
        for i = 0 to n - 1
            float v = array.get(a, i)
            if i % W == 0
                array.set(g, i, v)
            else
                array.set(g, i, math.max(array.get(g, i - 1), v))
            if i == 0
                array.set(pm, i, v)
            else
                array.set(pm, i, math.max(array.get(pm, i - 1), v))
        for i = n - 1 to 0
            float v = array.get(a, i)
            if i % W == W - 1 or i == n - 1
                array.set(h, i, v)
            else
                array.set(h, i, math.max(array.get(h, i + 1), v))
            if i == n - 1
                array.set(qm, i, v)
            else
                array.set(qm, i, math.max(array.get(qm, i + 1), v))
        for r = 0 to n - 1
            if r >= 1
                int x = r - W
                if x <= 0
                    array.set(L, r, array.get(pm, r - 1))
                else
                    array.set(L, r, math.max(array.get(h, x), array.get(g, r - 1)))
            if r <= n - 2
                int y = r + W
                if y >= n - 1
                    array.set(R, r, array.get(qm, r + 1))
                else
                    array.set(R, r, math.max(array.get(h, r + 1), array.get(g, y)))
    [L, R]

// LVN zones: detect on the smoothed profile, refine edges + core on the raw footprint volume
// → [low, high, core price, depth 0..1]
lvnZones(int kMin, int n, array<float> vol, array<float> sm, int W, int sN) =>
    zl = array.new_float()
    zh = array.new_float()
    zc = array.new_float()
    zd = array.new_float()
    if n > 4
        [L, R] = winMax(sm, n, W)
        int mg = int(math.round(mergePts / rowSz))
        int mw = int(math.round(minWPts / rowSz))
        ra = array.new_int()
        rb = array.new_int()
        int a = -1
        int b = -1
        for r = 1 to n - 2
            float rf = math.min(array.get(L, r), array.get(R, r))
            bool isLow = rf > 0 and array.get(sm, r) <= lvnFrac * rf
            if isLow
                if a < 0
                    a := r
                    b := r
                else if r - b - 1 <= mg
                    b := r
                else
                    array.push(ra, a)
                    array.push(rb, b)
                    a := r
                    b := r
        if a >= 0
            array.push(ra, a)
            array.push(rb, b)
        if array.size(ra) > 0
            for z = 0 to array.size(ra) - 1
                int za = array.get(ra, z)
                int zb = array.get(rb, z)
                // refine edges on raw volume inside the smoothed run ± smoothing radius
                int s0 = math.max(1, za - sN)
                int s1 = math.min(n - 2, zb + sN)
                int fa = -1
                int fb = -1
                for r = s0 to s1
                    float rf = math.min(array.get(L, r), array.get(R, r))
                    if rf > 0 and array.get(vol, r) <= lvnFrac * rf
                        if fa < 0
                            fa := r
                        fb := r
                if fa < 0
                    fa := za
                    fb := zb
                if fb - fa + 1 >= mw
                    // core = thinnest 3-row window inside the refined zone
                    int core = fa
                    float best = 1e100
                    for r = fa to fb
                        float t3 = array.get(vol, r - 1) + array.get(vol, r) + array.get(vol, r + 1)
                        if t3 < best
                            best := t3
                            core := r
                    float rfc = math.min(array.get(L, core), array.get(R, core))
                    float dep = rfc > 0 ? 1.0 - array.get(sm, core) / rfc : 0.0
                    array.push(zl, (kMin + fa * tpr) * tk)
                    array.push(zh, (kMin + (fb + 1) * tpr) * tk)
                    array.push(zc, (kMin + core * tpr) * tk + rowSz / 2)
                    array.push(zd, math.max(0.0, math.min(1.0, dep)))
    [zl, zh, zc, zd]

overlaps(float lo, float hi, array<float> zl, array<float> zh) =>
    bool ok = false
    if array.size(zl) > 0
        for i = 0 to array.size(zl) - 1
            if array.get(zl, i) <= hi + confTol and array.get(zh, i) >= lo - confTol
                ok := true
    ok

// ───────── draw (last bar — in Bar Replay that is the replayed bar — redrawn on every update)
var float nUpLo = na
var float nUpC  = na
var float nDnHi = na
var float nDnC  = na
var float nIn   = na
var int   fpBars = 0
var int   allBars = 0
if barstate.isconfirmed
    allBars += 1
    fpBars += na(fp) ? 0 : 1
if barstate.islast
    nUpLo := na
    nUpC  := na
    nDnHi := na
    nDnC  := na
    nIn   := na
    for l in line.all
        line.delete(l)
    for bx in box.all
        box.delete(bx)
    for lb in label.all
        label.delete(lb)

    int sN = int(math.round(smoothPts / rowSz))
    [cK, cN, cVol, cSm] = build(mComp, sN)
    int x1 = math.max(0, bar_index - backBars)
    int xP = bar_index + ext
    int xR = xP + (showProf ? profW : 0)

    if cN > 4
        [zl, zh, zc, zd] = lvnZones(cK, cN, cVol, cSm, toRows(winPts), sN)
        pdL = array.new_float()
        pdH = array.new_float()
        etL = array.new_float()
        etH = array.new_float()
        rtL = array.new_float()
        rtH = array.new_float()
        if useConf
            int sw = toRows(sessWin)
            [k1, n1, v1, s1] = build(mPd, sN)
            [a1, b1, c1, d1] = lvnZones(k1, n1, v1, s1, sw, sN)
            pdL := a1
            pdH := b1
            [k2, n2, v2, s2] = build(mEth, sN)
            [a2, b2, c2, d2] = lvnZones(k2, n2, v2, s2, sw, sN)
            etL := a2
            etH := b2
            [k3, n3, v3, s3] = build(mRth, sN)
            [a3, b3, c3, d3] = lvnZones(k3, n3, v3, s3, sw, sN)
            rtL := a3
            rtH := b3

        // LVN zones, nearest to price first
        int nz_ = array.size(zl)
        if nz_ > 0
            dist = array.new_float()
            for i = 0 to nz_ - 1
                float lo = array.get(zl, i)
                float hi = array.get(zh, i)
                array.push(dist, close > hi ? close - hi : close < lo ? lo - close : 0.0)
            ord = array.sort_indices(dist, order.ascending)
            int shown = 0
            for j = 0 to nz_ - 1
                int i = array.get(ord, j)
                float lo = array.get(zl, i)
                float hi = array.get(zh, i)
                bool cPd = useConf and overlaps(lo, hi, pdL, pdH)
                bool cEt = useConf and overlaps(lo, hi, etL, etH)
                bool cRt = useConf and overlaps(lo, hi, rtL, rtH)
                bool conf = cPd or cEt or cRt
                float dep = array.get(zd, i)
                float cp = array.get(zc, i)
                bool strong = dep >= strongD
                bool show = mode == "Všechny" or conf or (mode == "Potvrzené + silné" and strong)
                if show and shown < maxZ
                    shown += 1
                    box.new(x1, hi, xR, lo, border_color = na, bgcolor = color.new(lvnCol, conf ? alphaConf : alphaBase))
                    if showCore
                        line.new(x1, cp, xR, cp, color = color.new(coreCol, conf ? 20 : 55), width = 1, style = line.style_dotted)
                    if showLbl
                        string src = str.trim((cPd ? "PD " : "") + (cEt ? "ETH " : "") + (cRt ? "RTH" : ""))
                        string txt = str.tostring(math.round_to_mintick(lo), format.mintick) + "–" + str.tostring(math.round_to_mintick(hi), format.mintick) + "  • " + str.tostring(math.round_to_mintick(cp), format.mintick) + "  " + str.tostring(math.round(dep * 100)) + "%" + (conf ? "  " + src : "")
                        label.new(xR, cp, txt, style = label.style_label_left, color = color.new(color.black, 100), textcolor = conf ? color.new(lvnCol, 0) : color.new(lvnCol, 35), size = size.small, tooltip = "LVN zóna " + str.tostring(lo, format.mintick) + "–" + str.tostring(hi, format.mintick) + "\nJádro (nejtenčí cena): " + str.tostring(math.round_to_mintick(cp), format.mintick) + "\nHloubka údolí: " + str.tostring(math.round(dep * 100)) + " %" + (conf ? "\nPotvrzeno v: " + src : "\nNepotvrzeno session profilem"))
                    // nearest shown zones for the price scale
                    if lo > close and (na(nUpLo) or lo < nUpLo)
                        nUpLo := lo
                        nUpC := cp
                    if hi < close and (na(nDnHi) or hi > nDnHi)
                        nDnHi := hi
                        nDnC := cp
                    if lo <= close and hi >= close
                        nIn := cp

        // shelves (outside LVN zones)
        if showS
            int K = toRows(shelfPts)
            float mean = array.avg(cSm)
            if cN > 2 * K + 2 and mean > 0
                ratio = array.new_float(cN + 1, 0.0)
                for b = K to cN - K
                    float sA = 0.0
                    float sB = 0.0
                    for d = 0 to K - 1
                        sA += array.get(cSm, b + d)
                        sB += array.get(cSm, b - 1 - d)
                    float hiS = math.max(sA, sB) / K
                    float loS = math.max(math.min(sA, sB) / K, mean * 0.02)
                    if hiS >= mean
                        array.set(ratio, b, hiS / loS)
                int drawnS = 0
                for b = K to cN - K
                    float q = array.get(ratio, b)
                    if q >= shelfRat and drawnS < 40
                        bool isMax = true
                        for d = -K to K
                            int bb = b + d
                            if d != 0 and bb >= 0 and bb <= cN
                                float u = array.get(ratio, bb)
                                if u > q or (d > 0 and u == q)
                                    isMax := false
                        float p = (cK + b * tpr) * tk
                        bool inZone = false
                        if array.size(zl) > 0
                            for z = 0 to array.size(zl) - 1
                                if p > array.get(zl, z) + rowSz and p < array.get(zh, z) - rowSz
                                    inZone := true
                        if isMax and not inZone
                            line.new(x1, p, xR, p, color = color.new(shCol, 30), style = line.style_dashed)
                            drawnS += 1

        // HVN bands (optional)
        if showH
            float mean = array.avg(cSm)
            int W = math.max(1, int(toRows(winPts) / 2))
            int drawnH = 0
            for r = 1 to cN - 2
                float v = array.get(cSm, r)
                if v >= hvnMult * mean and drawnH < 20
                    bool isMax = true
                    for d = -W to W
                        int rr = r + d
                        if d != 0 and rr >= 0 and rr < cN
                            float u = array.get(cSm, rr)
                            if u > v or (d > 0 and u == v)
                                isMax := false
                    if isMax
                        int ea = r
                        int eb = r
                        while ea > 0 and array.get(cSm, ea - 1) >= 0.7 * v
                            ea -= 1
                        while eb < cN - 1 and array.get(cSm, eb + 1) >= 0.7 * v
                            eb += 1
                        box.new(x1, (cK + (eb + 1) * tpr) * tk, xR, (cK + ea * tpr) * tk, border_color = na, bgcolor = color.new(hvnCol, 88))
                        drawnH += 1

        // composite profile histogram on the right (≤ 250 boxes)
        if showProf
            int bk = math.max(1, int(math.ceil(cN / 250.0)))
            int nb = int(math.ceil(cN / bk))
            agg = array.new_float(nb, 0.0)
            for r = 0 to cN - 1
                int j = math.min(nb - 1, int(r / bk))
                array.set(agg, j, array.get(agg, j) + array.get(cVol, r))
            float vMax = array.max(agg)
            if vMax > 0
                for j = 0 to nb - 1
                    int len = int(math.round(profW * array.get(agg, j) / vMax))
                    if len > 0
                        float yb = (cK + j * bk * tpr) * tk
                        box.new(xR - len, yb + bk * rowSz, xR, yb, border_color = na, bgcolor = color.new(profCol, 55))

// ───────── single prints drawing (after the main block, which clears all drawings first)
var float nSpUp = na
var float nSpDn = na
if barstate.islast
    nSpUp := na
    nSpDn := na
    int xR2 = bar_index + ext + (showProf ? profW : 0)
    if array.size(spL) > 0
        for i = 0 to array.size(spL) - 1
            float lo = array.get(spL, i)
            float hi = array.get(spH, i)
            int xb = math.max(array.get(spB, i), bar_index - 9000)
            string src = array.get(spS, i) == 0 ? "RTH" : "ETH"
            box.new(xb, hi, xR2, lo, border_color = color.new(spCol, 45), border_style = line.style_dashed, bgcolor = color.new(spCol, 85))
            label.new(xR2, (lo + hi) / 2, "SP " + str.tostring(math.round_to_mintick(lo), format.mintick) + "–" + str.tostring(math.round_to_mintick(hi), format.mintick) + "  " + src + " " + str.format_time(array.get(spT, i), "dd.MM.", "America/New_York"), style = label.style_label_left, color = color.new(color.black, 100), textcolor = spCol, size = size.small, tooltip = "Single prints (nevyplněné) – " + src + " session " + str.format_time(array.get(spT, i), "dd.MM.yyyy", "America/New_York"))
            if lo > close and (na(nSpUp) or lo < nSpUp)
                nSpUp := lo
            if hi < close and (na(nSpDn) or hi > nSpDn)
                nSpDn := hi
    if spDev
        for s_ = 0 to 1
            bool on = s_ == 0 ? (spOnR and inRth and not na(t0R)) : (spOnE and inEth and not na(t0E))
            if on
                int t0 = s_ == 0 ? t0R : t0E
                int b0 = s_ == 0 ? b0R : b0E
                dl = array.new_float()
                dh = array.new_float()
                if s_ == 0
                    [ra_, rb_] = spRuns(cR)
                    dl := ra_
                    dh := rb_
                else
                    [ea_, eb_] = spRuns(cE)
                    dl := ea_
                    dh := eb_
                if array.size(dl) > 0
                    for i = 0 to array.size(dl) - 1
                        float lo = array.get(dl, i)
                        float hi = array.get(dh, i)
                        box.new(math.max(b0, bar_index - 9000), hi, xR2, lo, border_color = color.new(spCol, 65), border_style = line.style_dotted, bgcolor = color.new(spCol, 92))
                        label.new(xR2, (lo + hi) / 2, "SP dnes " + str.tostring(math.round_to_mintick(lo), format.mintick) + "–" + str.tostring(math.round_to_mintick(hi), format.mintick), style = label.style_label_left, color = color.new(color.black, 100), textcolor = color.new(spCol, 40), size = size.small)

// ───────── nearest zones on the price scale (exact prices, also in replay)
plot(showScale ? nUpLo : na, "LVN nad: hrana", color.new(lvnCol, 0), display = display.price_scale)
plot(showScale ? nUpC  : na, "LVN nad: jádro", color.new(coreCol, 0), display = display.price_scale)
plot(showScale ? nDnHi : na, "LVN pod: hrana", color.new(lvnCol, 0), display = display.price_scale)
plot(showScale ? nDnC  : na, "LVN pod: jádro", color.new(coreCol, 0), display = display.price_scale)
plot(showScale ? nIn   : na, "V LVN: jádro", color.new(color.yellow, 0), display = display.price_scale)
plot(showScale ? nSpUp : na, "Single print nad", color.new(spCol, 0), display = display.price_scale)
plot(showScale ? nSpDn : na, "Single print pod", color.new(spCol, 0), display = display.price_scale)

var table info = table.new(position.top_right, 1, 1)
if showInfo and barstate.islast
    bool live = not na(fp)
    string t = (live ? "Footprint ✓" : "Footprint ✗ – odhad z OHLC") + "  ·  " + str.tostring(math.round(100.0 * fpBars / math.max(allBars, 1))) + " % barů s FP"
    table.cell(info, 0, 0, t, text_color = live ? color.rgb(94, 224, 200) : color.rgb(255, 120, 120), text_size = size.small, bgcolor = color.new(color.black, 60))
