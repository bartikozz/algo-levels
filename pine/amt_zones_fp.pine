//@version=6
// AMT Zones FP — auction market theory zones built from real footprint data (volume at price, buy/sell per row).
// Requires TradingView Premium / Ultimate (request.footprint). Bars without footprint fall back to a bar-based estimate.
//
//  • HVN zones   : prices where the auction accepted value (high traded volume) in the lookback window and that price
//                  has since LEFT → reference on the return (responsive rejection at the edge or acceptance back inside).
//                  Each price row is shaded by its real traded volume, so the gradient IS the node's volume distribution.
//  • Stacked imbalances : ≥ N consecutive rows with buy (sell) imbalance inside one bar = initiative activity;
//                  kept as support (resistance) until price closes back through.
//  • Poor highs / lows  : extremes without excess (heavy volume on the extreme row, or equal highs/lows) = unfinished
//                  auctions, kept until repaired.
//  • Naked POC of the previous RTH session (exact, from the footprint).
indicator("AMT Zones FP", "AMT Zones FP", overlay = true, max_boxes_count = 500, max_lines_count = 200, max_labels_count = 50, max_bars_back = 2000)

// ───────── inputs
gP        = "Profil (footprint)"
tpr       = input.int(4, "Ticků na řádek", minval = 1, maxval = 100, group = gP, tooltip = "NQ/MNQ: 4 ticky = 1 bod. Větší číslo = hrubší, hladší profil.")
lookback  = input.int(390, "Lookback (bary)", minval = 30, maxval = 1900, group = gP, tooltip = "1m graf: 390 ≈ jedna RTH session, 1380 ≈ celý Globex den")
smoothN   = input.int(2, "Vyhlazení (řádky)", minval = 0, maxval = 8, group = gP)
hvnMult   = input.float(1.5, "HVN práh (× průměr profilu)", minval = 1.0, step = 0.05, group = gP)
edgeFrac  = input.float(0.5, "Hrana zóny (podíl vrcholu)", minval = 0.15, maxval = 0.9, step = 0.05, group = gP)
leftGap   = input.float(1.0, "Cena musí zónu opustit o (× ATR)", minval = 0.0, step = 0.25, group = gP)
maxZones  = input.int(6, "Max zón", minval = 1, maxval = 12, group = gP)

gO        = "Orderflow"
showImb   = input.bool(true, "Stacked imbalances", group = gO)
imbPct    = input.int(300, "Imbalance (%)", minval = 110, maxval = 1000, group = gO, tooltip = "Buy imbalance = ask objem řádku ≥ X % bid objemu řádku pod ním (a naopak).")
stackN    = input.int(3, "Min. řádků za sebou", minval = 2, maxval = 10, group = gO)
maxImb    = input.int(12, "Max aktivních", minval = 1, maxval = 40, group = gO)

gS        = "Struktura"
showPoor  = input.bool(true, "Poor highs / lows", group = gS)
pivLen    = input.int(4, "Délka pivotu", minval = 2, maxval = 20, group = gS)
poorFrac  = input.float(0.35, "Poor: objem krajního řádku ≥ (× max řádek baru)", minval = 0.05, maxval = 1.0, step = 0.05, group = gS)
showNpoc  = input.bool(true, "Naked POC předchozí RTH", group = gS)
sessRth   = input.session("0930-1600", "RTH (čas New York)", group = gS)

gV        = "Vzhled"
ext       = input.int(18, "Prodloužení doprava (bary)", minval = 0, maxval = 300, group = gV)
zCol      = input.color(color.rgb(36, 38, 44), "Barva zóny", group = gV)
minAlpha  = input.int(18, "Nejtmavší řádek (průhlednost)", minval = 0, maxval = 90, group = gV)
maxAlpha  = input.int(88, "Nejsvětlejší řádek (průhlednost)", minval = 40, maxval = 98, group = gV)
deltaTint = input.bool(false, "Obarvit hranu zóny podle delty", group = gV)
buyCol    = input.color(color.rgb(94, 224, 200), "Buy imbalance", group = gV)
sellCol   = input.color(color.rgb(255, 95, 162), "Sell imbalance", group = gV)
poorCol   = input.color(color.rgb(201, 166, 107), "Poor high/low", group = gV)
npocCol   = input.color(color.rgb(239, 83, 80), "Naked POC", group = gV)
showCount = input.bool(true, "Počet zón vlevo nahoře", group = gV)

// ───────── footprint of the current bar → rows (key = price in ticks of the row bottom)
footprint fp = request.footprint(tpr, 70, imbPct)
float tk  = syminfo.mintick
float rowSz = tk * tpr
keyOf(float p) => int(math.round(p / tk))
atr = ta.atr(50)

curK = array.new_int()
curV = array.new_float()
curD = array.new_float()
float maxRow = 0.0
float topRow = 0.0
float botRow = 0.0
bool hasFp = not na(fp)
if hasFp
    rs = footprint.rows(fp)
    n = array.size(rs)
    if n > 0
        for i = 0 to n - 1
            r = array.get(rs, i)
            v = volume_row.total_volume(r)
            array.push(curK, keyOf(volume_row.down_price(r)))
            array.push(curV, v)
            array.push(curD, volume_row.delta(r))
            maxRow := math.max(maxRow, v)
        botRow := array.get(curV, 0)
        topRow := array.get(curV, n - 1)
else
    // fallback: spread the bar's volume evenly over its range
    k0 = keyOf(math.floor(low / rowSz) * rowSz)
    k1 = keyOf(math.floor(high / rowSz) * rowSz)
    cnt = int(math.round((k1 - k0) / tpr)) + 1
    for k = 0 to cnt - 1
        array.push(curK, k0 + k * tpr)
        array.push(curV, nz(volume) / cnt)
        array.push(curD, 0.0)
    maxRow := nz(volume) / cnt
    topRow := maxRow
    botRow := maxRow
float topRatio = maxRow > 0 ? topRow / maxRow : 0.0
float botRatio = maxRow > 0 ? botRow / maxRow : 0.0

// ───────── rolling volume-at-price over the lookback (confirmed bars), the live bar is added at draw time
var map<int, float> mVol = map.new<int, float>()
var map<int, float> mDel = map.new<int, float>()
var array<int>   qBar = array.new_int()
var array<int>   qKey = array.new_int()
var array<float> qVol = array.new_float()
var array<float> qDel = array.new_float()
if barstate.isconfirmed and array.size(curK) > 0
    for i = 0 to array.size(curK) - 1
        k = array.get(curK, i)
        v = array.get(curV, i)
        d = array.get(curD, i)
        array.push(qBar, bar_index)
        array.push(qKey, k)
        array.push(qVol, v)
        array.push(qDel, d)
        map.put(mVol, k, nz(map.get(mVol, k)) + v)
        map.put(mDel, k, nz(map.get(mDel, k)) + d)
    while array.size(qBar) > 0 and array.get(qBar, 0) <= bar_index - lookback
        array.shift(qBar)
        k = array.shift(qKey)
        v = array.shift(qVol)
        d = array.shift(qDel)
        nv = nz(map.get(mVol, k)) - v
        if nv <= 1e-9
            map.remove(mVol, k)
            map.remove(mDel, k)
        else
            map.put(mVol, k, nv)
            map.put(mDel, k, nz(map.get(mDel, k)) - d)

// ───────── HVN zones (recomputed once per new bar)
var array<box>  zBoxes = array.new<box>()
var array<line> zLines = array.new<line>()
var label       cntLbl = na
varip int       lastCalcBar = -1

if barstate.islast and bar_index != lastCalcBar and map.size(mVol) > 0
    lastCalcBar := bar_index
    for b in zBoxes
        box.delete(b)
    array.clear(zBoxes)
    for l in zLines
        line.delete(l)
    array.clear(zLines)

    keys = map.keys(mVol)
    int kMin = array.min(keys)
    int kMax = array.max(keys)
    if array.size(curK) > 0
        kMin := math.min(kMin, array.min(curK))
        kMax := math.max(kMax, array.max(curK))
    int rowsN = math.min(1500, int(math.round((kMax - kMin) / tpr)) + 1)
    vol = array.new_float(rowsN, 0.0)
    del = array.new_float(rowsN, 0.0)
    for k in keys
        idx = int(math.round((k - kMin) / tpr))
        if idx >= 0 and idx < rowsN
            array.set(vol, idx, array.get(vol, idx) + map.get(mVol, k))
            array.set(del, idx, array.get(del, idx) + nz(map.get(mDel, k)))
    if array.size(curK) > 0
        for i = 0 to array.size(curK) - 1
            idx = int(math.round((array.get(curK, i) - kMin) / tpr))
            if idx >= 0 and idx < rowsN
                array.set(vol, idx, array.get(vol, idx) + array.get(curV, i))
                array.set(del, idx, array.get(del, idx) + array.get(curD, i))
    // smoothing (triangular kernel) — used only to find nodes; shading uses the raw row volume
    sm = array.new_float(rowsN, 0.0)
    for r = 0 to rowsN - 1
        float a = 0.0
        float c = 0.0
        for d = -smoothN to smoothN
            rr = r + d
            if rr >= 0 and rr < rowsN
                w = smoothN + 1 - math.abs(d)
                a += array.get(vol, rr) * w
                c += w
        array.set(sm, r, a / c)
    float tot = 0.0
    int nz_ = 0
    for r = 0 to rowsN - 1
        if array.get(vol, r) > 0
            tot += array.get(sm, r)
            nz_ += 1
    mean = nz_ > 0 ? tot / nz_ : 0.0
    peakRows = array.new_int()
    peakVols = array.new_float()
    win = math.max(3, smoothN * 2 + 1)
    if rowsN > 2
        for r = 1 to rowsN - 2
            v = array.get(sm, r)
            if v >= hvnMult * mean
                bool isMax = true
                for d = -win to win
                    rr = r + d
                    if d != 0 and rr >= 0 and rr < rowsN and array.get(sm, rr) > v
                        isMax := false
                if isMax
                    array.push(peakRows, r)
                    array.push(peakVols, v)
    int zoneCount = 0
    usedLo = array.new_float()
    usedHi = array.new_float()
    if array.size(peakRows) > 0
        ord = array.sort_indices(peakVols, order.descending)
        for j = 0 to array.size(ord) - 1
            if zoneCount >= maxZones
                break
            r  = array.get(peakRows, array.get(ord, j))
            pk = array.get(sm, r)
            int a = r
            int b = r
            while a > 0 and array.get(sm, a - 1) >= edgeFrac * pk
                a -= 1
            while b < rowsN - 1 and array.get(sm, b + 1) >= edgeFrac * pk
                b += 1
            zLo = (kMin + a * tpr) * tk
            zHi = (kMin + (b + 1) * tpr) * tk
            bool gone = close > zHi + leftGap * atr or close < zLo - leftGap * atr
            bool overlap = false
            if array.size(usedLo) > 0
                for u = 0 to array.size(usedLo) - 1
                    if zHi >= array.get(usedLo, u) and zLo <= array.get(usedHi, u)
                        overlap := true
            if gone and not overlap
                array.push(usedLo, zLo)
                array.push(usedHi, zHi)
                zoneCount += 1
                // zone start: oldest bar in the window that traded the node's peak row
                int x1 = bar_index - lookback + 1
                pkKey = kMin + r * tpr
                for q = 0 to array.size(qKey) - 1
                    if array.get(qKey, q) == pkKey
                        x1 := array.get(qBar, q)
                        break
                x2 = bar_index + ext
                // row-by-row shading = real volume distribution of the node
                float rowMax = 0.0
                float zDel = 0.0
                for rr = a to b
                    rowMax := math.max(rowMax, array.get(vol, rr))
                    zDel += array.get(del, rr)
                for rr = a to b
                    f  = rowMax > 0 ? array.get(vol, rr) / rowMax : 0.0
                    al = int(math.round(maxAlpha - (maxAlpha - minAlpha) * f))
                    yb = (kMin + rr * tpr) * tk
                    array.push(zBoxes, box.new(x1, yb + rowSz, x2, yb, border_color = na, bgcolor = color.new(zCol, al), xloc = xloc.bar_index))
                if deltaTint
                    ec = zDel >= 0 ? buyCol : sellCol
                    array.push(zLines, line.new(x1, zHi, x2, zHi, color = color.new(ec, 40)))
                    array.push(zLines, line.new(x1, zLo, x2, zLo, color = color.new(ec, 40)))
    if showCount
        label.delete(cntLbl)
        cntLbl := label.new(bar_index - math.min(lookback, bar_index) + 1, high, str.tostring(zoneCount), style = label.style_label_down, color = color.new(color.gray, 70), textcolor = color.white, size = size.small)

// ───────── stacked imbalances (initiative) — kept until price closes back through
var array<box>   imBox  = array.new<box>()
var array<float> imLo   = array.new_float()
var array<float> imHi   = array.new_float()
var array<int>   imSide = array.new_int()
if showImb and barstate.isconfirmed and hasFp
    rs = footprint.rows(fp)
    n = array.size(rs)
    int runB = 0
    int runS = 0
    float bLo = na
    float sLo = na
    if n > 0
        for i = 0 to n - 1
            r = array.get(rs, i)
            bool bi = volume_row.has_buy_imbalance(r)
            bool si = volume_row.has_sell_imbalance(r)
            if bi
                runB += 1
                if runB == 1
                    bLo := volume_row.down_price(r)
            bool endB = runB >= stackN and (not bi or i == n - 1)
            if endB
                top = volume_row.up_price(array.get(rs, bi ? i : i - 1))
                array.push(imBox, box.new(bar_index, top, bar_index + ext, bLo, border_color = color.new(buyCol, 40), bgcolor = color.new(buyCol, 82)))
                array.push(imLo, bLo)
                array.push(imHi, top)
                array.push(imSide, 1)
            if not bi
                runB := 0
            if si
                runS += 1
                if runS == 1
                    sLo := volume_row.down_price(r)
            bool endS = runS >= stackN and (not si or i == n - 1)
            if endS
                top = volume_row.up_price(array.get(rs, si ? i : i - 1))
                array.push(imBox, box.new(bar_index, top, bar_index + ext, sLo, border_color = color.new(sellCol, 40), bgcolor = color.new(sellCol, 82)))
                array.push(imLo, sLo)
                array.push(imHi, top)
                array.push(imSide, -1)
            if not si
                runS := 0
    while array.size(imBox) > maxImb
        box.delete(array.shift(imBox))
        array.shift(imLo)
        array.shift(imHi)
        array.shift(imSide)
if array.size(imBox) > 0
    for j = array.size(imBox) - 1 to 0
        bx = array.get(imBox, j)
        s  = array.get(imSide, j)
        if (s == 1 and close < array.get(imLo, j)) or (s == -1 and close > array.get(imHi, j))
            box.set_right(bx, bar_index)
            box.set_bgcolor(bx, color.new(s == 1 ? buyCol : sellCol, 94))
            box.set_border_color(bx, color.new(s == 1 ? buyCol : sellCol, 85))
            array.remove(imBox, j)
            array.remove(imLo, j)
            array.remove(imHi, j)
            array.remove(imSide, j)
        else
            box.set_right(bx, bar_index + ext)

// ───────── poor highs / lows (no excess) — kept until repaired
var array<line>  poorL = array.new<line>()
var array<float> poorP = array.new<float>()
var array<int>   poorS = array.new<int>()
ph = ta.pivothigh(high, pivLen, pivLen)
pl = ta.pivotlow(low, pivLen, pivLen)
if showPoor and not na(ph)
    int eq = 0
    for i = 0 to 2 * pivLen
        if math.abs(high[i] - ph) <= tk
            eq += 1
    if eq >= 2 or topRatio[pivLen] >= poorFrac
        array.push(poorL, line.new(bar_index - pivLen, ph, bar_index + ext, ph, color = poorCol, style = line.style_dashed))
        array.push(poorP, ph)
        array.push(poorS, 1)
if showPoor and not na(pl)
    int eq = 0
    for i = 0 to 2 * pivLen
        if math.abs(low[i] - pl) <= tk
            eq += 1
    if eq >= 2 or botRatio[pivLen] >= poorFrac
        array.push(poorL, line.new(bar_index - pivLen, pl, bar_index + ext, pl, color = poorCol, style = line.style_dashed))
        array.push(poorP, pl)
        array.push(poorS, -1)
if array.size(poorL) > 0
    for j = array.size(poorL) - 1 to 0
        p  = array.get(poorP, j)
        s  = array.get(poorS, j)
        ln = array.get(poorL, j)
        if (s == 1 and high > p + tk) or (s == -1 and low < p - tk)
            line.set_x2(ln, bar_index)
            line.set_color(ln, color.new(poorCol, 75))
            array.remove(poorL, j)
            array.remove(poorP, j)
            array.remove(poorS, j)
        else
            line.set_x2(ln, bar_index + ext)

// ───────── naked POC of the previous RTH session (exact volume at price)
inRth    = not na(time(timeframe.period, sessRth, "America/New_York"))
rthStart = inRth and not inRth[1]
rthEnd   = not inRth and inRth[1]
var map<int, float> sVol = map.new<int, float>()
var line  npoc  = na
var float npocP = na
if rthStart
    map.clear(sVol)
if inRth and barstate.isconfirmed and array.size(curK) > 0
    for i = 0 to array.size(curK) - 1
        k = array.get(curK, i)
        map.put(sVol, k, nz(map.get(sVol, k)) + array.get(curV, i))
if showNpoc and rthEnd and map.size(sVol) > 0
    sk = map.keys(sVol)
    int bestK = array.get(sk, 0)
    float bestV = -1.0
    for k in sk
        v = map.get(sVol, k)
        if v > bestV
            bestV := v
            bestK := k
    line.delete(npoc)
    npocP := bestK * tk + rowSz / 2
    npoc := line.new(bar_index - 1, npocP, bar_index + ext, npocP, color = npocCol, width = 1)
if not na(npoc)
    if not rthEnd and high >= npocP and low <= npocP
        line.set_x2(npoc, bar_index)
        line.set_color(npoc, color.new(npocCol, 80))
        npoc := na
        npocP := na
    else
        line.set_x2(npoc, bar_index + ext)
